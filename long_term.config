# long_term.config — 长期记忆（Long-term Memory）可调参数
# 主方案 D7/D9（2026-08-12 用户拍板冻结）；由 sar_orch/long_term_reflection.py 经 configparser 读取，
# 缺失项使用默认值。模型凭证不在此文件：走 .env 的 reflection_provider / reflection_api_key /
# reflection_api_base / reflection_model（主方案 D8）。
# 注意：值行不得带行内注释（configparser 默认把 # 之后的文本并入值）。

[window]
# 单次反思增量窗口上限：事件数与字符数；超出按 sequence 取最近 N 条并在 reflection_run 记 truncated=true
max_events = 200
max_chars = 8000

[trigger]
# 滚动反思触发条件：任一满足且距上次反思 >= min_interval_sec 才真正调用（异步执行，进行中反思 coalesce 跳过）
# 每 task 完成
task_complete = true
# 每 supervision 事件
supervision_event = true
# 每 N 个 env_step 检查
every_env_step = 5
# 最小触发间隔（秒）
min_interval_sec = 30

[quality]
# 只读质量 evaluator 输出开关（P4，mode=ro）
enabled = true

[timeout]
# 反思（含 terminal 收尾 join）超时（秒）；超时写 typed timeout status，不阻塞 run 退出
reflection_sec = 60

[diagnosis]
# System Health 诊断通道（P3/P4；由 coordinator 经 load_diagnosis_config 读取；
# 值行不得带行内注释，见文件头）
# 独立注入旋钮（A2 消融实验开关）：true = 注入 ### System Health 段
inject_enabled = true
# 注入置信度阈值（D4）：低于该值的诊断不注入
min_confidence = 0.6
# agentic 诊断审查循环最大轮次（D7）
max_rounds = 3
# 诊断审查单轮时间预算（秒，D7；当前仓库运行配置 150；配置缺失时代码默认 90）
diagnosis_sec = 150
# System Health 段固定上限预算档（R3 修订）：默认 3 与 long-term 同档；
# 调小 = 低预算也保留段；调大 = 更早裁剪并留 TRUNCATED
section_budget_threshold = 3
