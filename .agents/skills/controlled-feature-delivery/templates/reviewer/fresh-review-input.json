{
  "schema_version": "1.0",
  "change_id": "<change-id>",
  "review_mode": "final_gate",
  "language": "zh-CN",
  "scope": {
    "base_sha": "<full-base-sha>",
    "head_sha": "<full-head-sha>",
    "head_tree_sha": "<git-rev-parse-head-tree-output>",
    "captured_at": "<ISO-8601 timestamp>",
    "git_status_path": "<path-to-captured-git-status.txt>",
    "diff_command": "git diff --no-ext-diff --find-renames <base_sha> <head_sha>",
    "diff_path": "<path-to-frozen-git-diff.patch>",
    "diff_sha256": "<SHA-256-of-diff_path>",
    "name_status_path": "<path-to-git-name-status.txt>",
    "diff_check_path": "<path-to-git-diff-check.txt>"
  },
  "approved_intent": {
    "plan_path": "<path-to-approved-plan>",
    "requirements": [
      {
        "id": "REQ-1",
        "statement": "<observable requirement / success criterion>",
        "source": "<plan section or requirement reference>"
      }
    ],
    "non_goals": ["<explicit non-goal>"],
    "allowed_paths": ["<repository-relative path or glob>"],
    "forbidden_paths": ["<repository-relative path or glob>"]
  },
  "verification": {
    "record_path": "<path-to-verification-record.json-or-md>",
    "required_checks": [
      {
        "id": "VERIFY-1",
        "kind": "focused_test|integration|lint|build|smoke|other",
        "required": true,
        "result_path": "<path-to-command-result-or-artifact>"
      }
    ]
  },
  "documentation_context": {
    "docs_index_path": "<path-to-docs-index-or-N/A-with-reason>",
    "candidate_paths": ["<durable document paths likely affected>"]
  },
  "risk_context": {
    "record_path": "<path-or-N/A-with-reason>",
    "prior_accepted_risks": []
  },
  "output": {
    "directory": ".agents/runs/<change-id>/",
    "final_review_path": ".agents/runs/<change-id>/final-review.json",
    "review_report_path": ".agents/runs/<change-id>/fresh-review-report.md",
    "doc_impact_path": ".agents/runs/<change-id>/doc-impact.json"
  }
}
