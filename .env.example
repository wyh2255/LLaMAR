# .env.example — 复制为 .env 并填写真实值（字段必须 lowercase，见 AGENTS.md）
# 主 LLM 配置（coordinator / worker 共用）
provider=openai
api_key=your-api-key
api_base=https://api.deepseek.com
model=deepseek-v4-flash

# 长期记忆反思模型独立配置口（主方案 D8，2026-08-12 冻结）
# 缺 reflection_api_key 时：read 模式启动显式拒绝（typed 错误），不静默降级；保持 off/shadow
reflection_provider=openai
reflection_api_key=
reflection_api_base=https://api.deepseek.com
reflection_model=deepseek-v4-flash

# Coordinator 回调认证（shadow/read_port 模式必需；experiment.py 会自动生成 per-run secret）
coordinator_secret=
